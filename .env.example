# Nuxt server-side BFF configuration. These values are private runtime config.
NUXT_API_BASE_URL=http://localhost:8000/v1
NUXT_OIDC_ISSUER=https://auth.codestra.co/realms/larimia
NUXT_OIDC_CLIENT_ID=larimia-customer-web
NUXT_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
NUXT_SESSION_COOKIE_SECURE=false

# Public realtime endpoint. WebSockets use one-time tickets, never access tokens.
NUXT_PUBLIC_WEBSOCKET_BASE_URL=ws://localhost:8000/v1/ws

# Native applications call the API directly after Authorization Code + PKCE.
VITE_API_BASE_URL=http://localhost:8000/v1
VITE_OIDC_ISSUER=https://auth.codestra.co/realms/larimia
VITE_CUSTOMER_OIDC_CLIENT_ID=larimia-customer-mobile
VITE_PRO_OIDC_CLIENT_ID=larimia-pro-mobile
